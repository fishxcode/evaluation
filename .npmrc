# Use a hoisted (flat) node_modules layout instead of pnpm's symlinked store.
# Vercel's file tracer (NFT) does not recreate pnpm's top-level symlinks in the
# serverless bundle, so nested deps like reflect-metadata / @nestjs/* / @models-dev/*
# fail to resolve at runtime (FUNCTION_INVOCATION_FAILED). A flat layout is
# traced correctly.
# 用扁平 node_modules 取代 pnpm 符号链接 store。Vercel 的 NFT 不会在 serverless
# 包中重建 pnpm 顶层符号链接，导致 reflect-metadata/@nestjs/*/@models-dev/* 运行时
# 解析失败。扁平布局可被正确追踪。
node-linker=hoisted
