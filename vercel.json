{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{data/merged/**,apps/api/dist/**,packages/shared/dist/**,packages/data/dist/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/docs", "destination": "/api" },
    { "source": "/api/docs/(.*)", "destination": "/api" },
    { "source": "/api-json", "destination": "/api" },
    { "source": "/models", "destination": "/api" },
    { "source": "/models/(.*)", "destination": "/api" },
    { "source": "/labs", "destination": "/api" },
    { "source": "/labs/(.*)", "destination": "/api" },
    { "source": "/providers", "destination": "/api" },
    { "source": "/benchmarks", "destination": "/api" },
    { "source": "/pricing", "destination": "/api" },
    { "source": "/stats", "destination": "/api" },
    { "source": "/metadata", "destination": "/api" },
    { "source": "/filters", "destination": "/api" },
    { "source": "/search", "destination": "/api" },
    { "source": "/status", "destination": "/api" },
    { "source": "/refresh", "destination": "/api" },
    { "source": "/admin/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
