PORT=3000
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3000

# Public refresh endpoint token for POST /refresh.
# POST /refresh 公共刷新端点鉴权 token。
REFRESH_TOKEN=change-me-refresh-token

# Admin Console bootstrap account.
# Admin Console 初始账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2$210000$replace-salt$replace-hash
ADMIN_SESSION_SECRET=change-me-admin-session-secret
JWT_SECRET=change-me-admin-session-secret

# Runtime data paths.
# 运行期数据路径。
DATA_DIR=./data
MODELS_DATASET_PATH=./data/merged/models.json
ANALYTICS_STATE_PATH=./data/analytics/pageviews.json
API_USAGE_STATE_PATH=./data/admin/api-usage.json
ADMIN_STATE_DIR=./data/admin

# Data refresh schedule. Docker uses REFRESH_INTERVAL_SECONDS; external schedulers can use REFRESH_CRON.
# 数据刷新计划。Docker 使用 REFRESH_INTERVAL_SECONDS；外部调度器可使用 REFRESH_CRON。
REFRESH_INTERVAL_SECONDS=21600
REFRESH_CRON=0 */6 * * *
