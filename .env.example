# Environment Variables — copy to .env and fill in real values
# cp .env.example .env

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Data pipeline ---
# Token to authenticate POST /refresh
REFRESH_TOKEN=change-me-to-a-random-secret

# Absolute or relative path to data/ directory (default: ./data)
DATA_DIR=./data

# Cron expression for automatic data refresh (e.g. "0 */6 * * *" = every 6h)
# Leave empty to disable automatic refresh
REFRESH_CRON=0 */6 * * *

# --- Admin Console (Chapter 9) ---
# Initial admin username
ADMIN_USERNAME=admin

# bcrypt/argon2 hash of the admin password (generate with: node -e "require('bcrypt').hash('yourpwd',12).then(console.log)")
ADMIN_PASSWORD_HASH=$2b$12$placeholder_replace_with_real_hash

# JWT signing secret (use a long random string)
JWT_SECRET=change-me-to-a-long-random-jwt-secret

# JWT expiry (default: 8h)
JWT_EXPIRES_IN=8h
